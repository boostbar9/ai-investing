# =====================================================================
# ai-investing — environment variable contract (v3.1)
# Copy to .env.local and fill in. NEVER commit .env or .env.local.
# Production values live in Doppler / 1Password CLI.
# =====================================================================

# ---- Runtime ----
APP_ENV=development            # development | staging | production
LOG_LEVEL=info                 # debug | info | warn | error
TZ=America/Los_Angeles

# ---- Database ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_investing
POSTGRES_USER=ai
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://ai:change_me@localhost:5432/ai_investing

# ---- Cache (DragonflyDB, Redis-compatible) ----
DRAGONFLY_URL=redis://localhost:6379/0

# ---- Temporal ----
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=ai-investing

# ---- LLMs (local via Ollama) ----
OLLAMA_HOST=http://localhost:11434
LLM_REASONING=deepseek-r1:70b
LLM_CODE_FINANCE=qwen2.5:72b
LLM_BACKUP=llama3.3:70b
LLM_BACKUP_ALT=mistral-large:latest
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# ---- Broker (Alpaca paper to start) ----
# Generate free paper keys at: https://app.alpaca.markets/paper/dashboard/overview
# (NOT the Alpaca Connect OAuth page — that's for public-facing apps and
# requires compliance review. You just need API keys for your own account.)
# Verify with: PYTHONPATH=. python3 tools/smoke_alpaca.py
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Live keys live ONLY in the execution-agent secret store, not here.

# ---- Market data ----
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
SEC_EDGAR_USER_AGENT="ai-investing dev@example.com"

# ---- Sentiment (optional) ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-investing/0.1
X_BEARER_TOKEN=

# ---- Approvals ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---- Push notifications ----
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
FIREBASE_SERVER_KEY=

# ---- Observability ----
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset (or commented) for local dev without
# docker-compose. When set, the cockpit probes the endpoint at startup and
# auto-disables the exporter with a single warning if nothing is listening,
# so log spam stays out of the way.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ai-investing
GRAFANA_URL=http://localhost:3001

# ---- Inter-service auth (JWT) ----
INTERNAL_JWT_SECRET=change_me_32_bytes_min
INTERNAL_JWT_TTL_SECONDS=300

# ---- Cockpit ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_OTEL_ENDPOINT=http://localhost:4318
NEXTAUTH_SECRET=change_me
NEXTAUTH_URL=http://localhost:3000

# ---- Feature flags ----
# Paper-broker master kill switch. Must be 'true' for the paper loop to
# actually submit orders to Alpaca paper -- otherwise every run halts with
# 'ENABLE_PAPER_TRADING != true' and the soak makes zero progress.
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false      # MUST remain false until §16 acceptance criteria met
ENABLE_REDDIT_SENTIMENT=false
ENABLE_X_SENTIMENT=false

# ---- Under-the-radar catalyst lane ----
# Discovery lane that deliberately surfaces under-followed small/micro-cap
# names WITH a real catalyst. All knobs are env-overridable; the defaults are
# the user-chosen values. Read-only data only (no paid feeds).
RADAR_MIN_PRICE=0.50            # price floor; below this -> excluded
RADAR_MIN_DOLLAR_VOL=1000000    # min avg daily DOLLAR volume; below -> excluded
RADAR_MAX_SPREAD_PCT=0.035      # max bid/ask spread (fraction of mid); above -> excluded
RADAR_MAX_MARKET_CAP=2000000000 # under-radar cap ceiling ($2B small-cap line)
RADAR_MAX_PRICE=50.0            # price-ceiling fallback when market cap unknown
