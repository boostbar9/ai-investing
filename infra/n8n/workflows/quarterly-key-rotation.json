{
  "name": "Quarterly Key Rotation Reminder",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 14 1 1,4,7,10 *"
            }
          ]
        }
      },
      "id": "cron-quarterly",
      "name": "Quarterly cron (1st @ 14:00 UTC)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "notes": "Fires at 14:00 UTC on Jan 1, Apr 1, Jul 1, Oct 1.\n14:00 UTC = 06:00 PT = 07:00 PT during DST.\nMatches §10 daily-briefing window so the operator is already in-app."
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "ts",
              "value": "={{ $now.toISO() }}"
            },
            {
              "name": "scope",
              "value": "broker, market_data, notifications, internal_jwt"
            },
            {
              "name": "runbook",
              "value": "https://github.com/boostbar9/ai-investing/blob/main/docs/runbooks/key-rotation.md"
            }
          ]
        },
        "options": {}
      },
      "id": "build-context",
      "name": "Build payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{$env.TELEGRAM_CHAT_ID}}\",\n  \"text\": \"\ud83d\udd11 *Quarterly Key Rotation Due*\\n\\nScope: {{$json.scope}}\\nTimestamp: {{$json.ts}}\\nRunbook: {{$json.runbook}}\\n\\nReply /rotated when complete. Pings again in 48h if no reply.\",\n  \"parse_mode\": \"Markdown\",\n  \"disable_web_page_preview\": true\n}",
        "options": {}
      },
      "id": "telegram-ping",
      "name": "Telegram reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 220]
    },
    {
      "parameters": {
        "url": "={{$env.DISCORD_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"username\": \"ai-investing security\",\n  \"content\": \"\ud83d\udd11 **Quarterly key rotation due** — scope: {{$json.scope}}. Runbook: {{$json.runbook}}\"\n}",
        "options": {}
      },
      "id": "discord-ping",
      "name": "Discord reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 380]
    },
    {
      "parameters": {
        "url": "={{$env.AI_INVESTING_API_BASE}}/security/rotation-reminder",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ts\": \"{{$json.ts}}\",\n  \"scope\": \"{{$json.scope}}\",\n  \"runbook\": \"{{$json.runbook}}\",\n  \"channel\": \"n8n-quarterly\"\n}",
        "options": {}
      },
      "id": "audit-log",
      "name": "Audit log (immutable)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Quarterly cron (1st @ 14:00 UTC)": {
      "main": [[{ "node": "Build payload", "type": "main", "index": 0 }]]
    },
    "Build payload": {
      "main": [
        [
          { "node": "Telegram reminder", "type": "main", "index": 0 },
          { "node": "Discord reminder", "type": "main", "index": 0 }
        ]
      ]
    },
    "Telegram reminder": {
      "main": [[{ "node": "Audit log (immutable)", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "tags": [
    { "name": "security" },
    { "name": "rotation" }
  ]
}
